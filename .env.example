# Required for NTA GTFS-Realtime Vehicles and TripUpdates.
# Apply for access at:
# https://developer.nationaltransport.ie/
NTA_API_KEY=

# CARTO Voyager browser key. Required for a watermark-free basemap.
# Request at https://www.carto.com/basemaps/apikey/
# Public in tile requests; restrict allowed websites in the CARTO dashboard.
PUBLIC_CARTO_API_KEY=

# Optional. Enables trusted-origin access to internal health routes when
# supplied as the x-origin-secret request header.
ORIGIN_SECRET=

# Optional local defaults.
PORT=3000
BUS_DB_DIR=./src/data
